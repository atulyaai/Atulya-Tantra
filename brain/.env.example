# Keep the service local until an authenticated gateway is ready.
ATULYA_HOST=127.0.0.1
ATULYA_PORT=8000
ATULYA_DATA_DIR=./data
ATULYA_WORKSPACE_DIR=..

# Required before sharing the API beyond the local machine.
# ATULYA_API_TOKEN=replace-with-a-long-random-secret

# Optional OpenAI-compatible text model endpoint.
# ATULYA_MODEL_BASE_URL=http://127.0.0.1:11434/v1
# ATULYA_MODEL_NAME=your-local-model
# ATULYA_MODEL_API_KEY=
