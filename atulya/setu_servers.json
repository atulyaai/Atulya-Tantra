{
  "servers": [
    {
      "name": "filesystem",
      "enabled": true,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    {
      "name": "git",
      "enabled": true,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-git"]
    },
    {
      "name": "playwright",
      "enabled": true,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp"]
    },
    {
      "name": "mqtt",
      "enabled": false,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-mqtt"]
    },
    {
      "name": "fetch",
      "enabled": false,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    {
      "name": "brave-search",
      "enabled": false,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": ""
      }
    },
    {
      "name": "twilio",
      "enabled": false,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-twilio"]
    },
    {
      "name": "home-assistant",
      "enabled": false,
      "timeout": 10,
      "transport": "http",
      "url": "http://127.0.0.1:8123/mcp",
      "env": {
        "HOME_ASSISTANT_TOKEN": ""
      }
    },
    {
      "name": "memory",
      "enabled": false,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    },
    {
      "name": "fetch",
      "enabled": true,
      "timeout": 10,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-fetch"]
    },
    {
      "name": "brave-search",
      "enabled": false,
      "timeout": 10,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": ""
      }
    },
    {
      "name": "google_drive",
      "enabled": false,
      "timeout": 5,
      "transport": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-google-drive"],
      "env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "info",
        "DISABLE_CONSOLE_OUTPUT": "true"
      }
    }
  ]
}
