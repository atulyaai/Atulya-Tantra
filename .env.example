# Atulya Tantra configuration
# Copy to .env and customize

# Host & Port Configuration (Set host to 0.0.0.0 for mobile/local network access)
ATULYA_HOST=127.0.0.1
ATULYA_PORT=8501

# Paths
ATULYA_DATA_DIR=assets

# Integrations
# Never commit real tokens here. Put live values only in local .env.
ATULYA_TELEGRAM_BOT_TOKEN=
ATULYA_TELEGRAM_CHAT_ID=
ATULYA_TELEGRAM_ALLOWLIST=
ATULYA_TELEGRAM_ALLOW_SEND=0

# Google MCP integrations
# Drive uses a Google service-account JSON key, minified into one line.
# Gmail uses OAuth client credentials plus a refresh token generated locally.
GOOGLE_SERVICE_ACCOUNT_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_OAUTH_PORT=3000

# Free-first brain provider chain
# 0. Tiny local GGUF brain — FIRST choice, fully offline, no Ollama, no torch.
#    Install with:  pip install -e ".[brain]"
#    Auto-download the ~380 MB Qwen3-0.6B model on first run:
ATULYA_AUTO_DOWNLOAD_MODEL=true
# Where models live (portable: kept inside the project's runtime/ folder):
# ATULYA_MODEL_DIR=runtime/models
# To switch models: drop any GGUF in that folder and point this at it,
# then set a display name for the UI:
# ATULYA_GGUF_PATH=runtime/models/your-model.gguf
# ATULYA_LOCAL_MODEL_NAME=Your Model 1B
# Tuning (optional): context, threads, sampling
# ATULYA_LOCAL_MODEL_CONTEXT=4096
# ATULYA_LOCAL_THREADS=4
# ATULYA_LOCAL_TEMPERATURE=0.6
# 1. Ollama local provider (free/offline) — optional heavier alternative
ATULYA_OLLAMA_MODEL=llama3
ATULYA_OLLAMA_HOST=http://localhost:11434
# 3. Groq free cloud brain (fast, smart, free). To turn it on:
#    a) Sign in at https://console.groq.com/keys and click "Create API Key".
#    b) Paste it below, e.g. GROQ_API_KEY=gsk_...
#    c) Set ATULYA_BRAIN=cloud to make Groq lead; the local 0.6B model stays the offline backup.
GROQ_API_KEY=
ATULYA_GROQ_MODEL=llama-3.3-70b-versatile
# 4. OpenRouter free models when configured
OPENROUTER_API_KEY=
ATULYA_OPENROUTER_MODEL=openrouter/free
# 6. Gemini free tier, rare fallback when explicitly configured
GEMINI_API_KEY=
ATULYA_GEMINI_MODEL=gemini-1.5-flash
# 7. OpenAI optional paid fallback only
OPENAI_API_KEY=
ATULYA_OPENAI_MODEL=gpt-4o-mini
# 8. NVIDIA NIM optional fallback
NVIDIA_API_KEY=
# NIM_API_KEY is also accepted as fallback
ATULYA_NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# 9. OpenCode Zen fallback (offline persona-based response, no key required)

# Brain size — one setting (see atulya/docs/COGNITIVE_ARCHITECTURE.md):
#   tiny (Qwen3-0.6B, default) | balanced (Qwen3-1.7B) | power (Qwen3-4B)
#   cloud = configured cloud providers first, local tiny as offline fallback
ATULYA_BRAIN=tiny
# How many tools the model is shown (small models do better with fewer)
# ATULYA_MAX_TOOL_SCHEMAS=14

# Safety — actions allowed without asking (comma list of tool or tool:action).
# By default unlocking, sending email, deletions and code execution ask first.
# ATULYA_AUTO_APPROVE=home_control:unlock

# Proactivity — trigger rules file and self-check interval (seconds)
# ATULYA_TRIGGERS_FILE=assets/agent/triggers.json
# ATULYA_HEARTBEAT_INTERVAL=300

# Real smart-home control via Home Assistant (long-lived token from your HA profile).
# Without these, home control uses a built-in simulation.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
# Optional device-id -> entity-id map (defaults: living_room_light -> light.living_room, ...)
# HOME_ASSISTANT_ENTITIES={"living_room_light": "light.lounge", "fan": "switch.bedroom_fan"}

# Routines (multi-step plans) and what Atulya learns about each user.
# ATULYA_ROUTINES_FILE=assets/agent/routines.json
# ATULYA_PROFILE_DIR=assets/agent/profiles

# Senses — cameras watched for motion and people ("someone is at the door").
# name=source pairs: a webcam number, rtsp:// or http:// stream, a snapshot URL,
# or a Home Assistant camera (ha:camera.front_door). Needs: pip install -e ".[vision]"
# ATULYA_CAMERAS=front_door=rtsp://user:pass@192.168.1.20/stream
# Home Assistant doorbells/people/motion sensors are watched automatically when
# HOME_ASSISTANT_URL is set; limit to specific entities or turn it off with:
# HOME_ASSISTANT_WATCH=event.front_door_doorbell,binary_sensor.front_door_person
# ATULYA_WATCH_HOME=true

# Google sign-in (Gmail + Calendar). Or paste these in the web UI: About you → Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Public address of this server when behind a proxy (for the Google redirect URI)
# ATULYA_PUBLIC_URL=https://atulya.example.com
# Whose Google account scheduled automations use (default: the only connected one)
# ATULYA_GOOGLE_DEFAULT_USER=

# web_fetch only reads public http(s) pages; set to 1 to allow your LAN too.
# ATULYA_FETCH_ALLOW_PRIVATE=0

# Security & Session Authentication
ATULYA_DASHBOARD_TOKEN=your_secure_auth_token_here
# Signing key for sign-in tokens. Default: created once in config/jwt_secret.key.
# ATULYA_JWT_SECRET=
# Other sites allowed to call the API (the web UI itself needs nothing here).
# ATULYA_CORS_ORIGINS=https://my-dashboard.example.com

# Debug
ATULYA_DEBUG=0
