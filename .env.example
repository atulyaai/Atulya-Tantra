# Atulya local configuration
# Copy this file to .env and set values for the features you use.

# Display name (the product can be renamed without changing Python imports).
ATULYA_ASSISTANT_NAME=Atulya

# App listener stays loopback. For remote access, use a TLS reverse proxy and set
# its exact public origin; passkey sign-in only accepts that origin.
ATULYA_HOST=127.0.0.1
ATULYA_PORT=8501
ATULYA_DATA_DIR=data
# Example: https://jarvis.example.com (leave blank for localhost development).
ATULYA_PUBLIC_ORIGIN=
# Only trust a reverse proxy on this machine by default. Never use '*'.
ATULYA_TRUSTED_PROXY_IPS=127.0.0.1,::1
# Required only for first-admin enrollment on a non-local public origin.
# Use a long random secret and remove it after the first passkey is registered.
ATULYA_ADMIN_SETUP_TOKEN=

# Local voice models (downloaded by start.bat / start.sh on first run).
ATULYA_STT_MODEL=base

# Brain provider: auto, local, ollama, openai-compatible, openrouter, nvidia, gemini, or deepseek.
# Leave empty (auto) to race at most two configured providers, then use local chat if available.
ATULYA_MODEL_PROVIDER=auto
ATULYA_PROVIDER_HEDGE_SECONDS=1.25
ATULYA_MODEL_NAME=
ATULYA_MODEL_BASE_URL=
ATULYA_MODEL_API_KEY=
# Cloud provider models/keys are read from their normal environment variable names.
# ATULYA_OPENROUTER_MODEL=
# OPENROUTER_API_KEY=
# ATULYA_NVIDIA_MODEL=
# NVIDIA_API_KEY=
# ATULYA_GEMINI_MODEL=
# GEMINI_API_KEY=
# ATULYA_DEEPSEEK_MODEL=
# DEEPSEEK_API_KEY=

# Telegram replies are private-chat only and require the sender's numeric Telegram user ID.
# Leave both blank to keep the Telegram channel disabled.
ATULYA_TELEGRAM_BOT_TOKEN=
ATULYA_TELEGRAM_ALLOWLIST=

# Performance. Load speech (and the offline model when it is the only option) at startup.
ATULYA_PRELOAD=1
# Local model GPU offload: auto (all layers when a GPU runtime was installed), or a layer count.
ATULYA_GPU_LAYERS=auto

# Morning briefing: weather city, and the local time to send it on Telegram (HH:MM; empty = off).
# The WebUI also shows it on your first visit each day.
ATULYA_BRIEFING_CITY=
ATULYA_BRIEFING_TIME=
